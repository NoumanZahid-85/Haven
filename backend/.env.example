# Copy to backend/.env and fill in real values for local development.
# In production (Render), these are injected via the dashboard / render.yaml — never commit real secrets.

# ── Storage ─────────────────────────────────────────────────────
# Postgres for turns, memories and evals. For a zero-setup local run:
#   DATABASE_URL=sqlite+aiosqlite:///local_dev.db   (needs `uv sync` dev deps)
DATABASE_URL=postgresql+asyncpg://haven:haven@localhost:5432/haven
# Optional: short-term conversation window. Without it, each turn has no history.
REDIS_URL=redis://localhost:6379

# ── Providers ───────────────────────────────────────────────────
# Gemini: Natural mode (Gemini Live speech-to-speech), fallback LLM, embeddings. Free tier works.
GEMINI_API_KEY=
# Deepgram: Checked mode — Flux streaming STT + Aura-2 streaming TTS. $200 free credit on sign-up.
DEEPGRAM_API_KEY=
# Groq: Checked-mode and text-chat LLM (gpt-oss-120b). Free tier works.
GROQ_API_KEY=
# Optional OpenAI-compatible fallback LLM.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=

# ── Application ─────────────────────────────────────────────────
APP_NAME=Haven
DEBUG=true
LOG_LEVEL=info
